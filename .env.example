# Copy to `.env` and adjust. Every setting maps to the Settings model in
# sa_platform.config; `__` denotes nesting (SA_LLM__MODEL -> settings.llm.model).
# A YAML file pointed at by SA_CONFIG_FILE is merged underneath these.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SA_ENVIRONMENT=local            # local | dev | staging | prod
SA_SERVICE_NAME=skill-accelerator
SA_DEBUG=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
SA_LOGGING__LEVEL=INFO
SA_LOGGING__FORMAT=json         # json in deployed environments, text locally

# ---------------------------------------------------------------------------
# LLM — the default profile (OpenAI)
# ---------------------------------------------------------------------------
# THE CREDENTIAL GOES HERE. Put the real value in `.env` (git-ignored), never in
# a YAML config file. Either variable works: SA_LLM__API_KEY is read first, then
# the vendor's own conventional variable.
OPENAI_API_KEY=sk-...
# SA_LLM__API_KEY=sk-...

SA_LLM__PROVIDER=openai         # anthropic | openai | gemini | stub
SA_LLM__MODEL=gpt-4o
SA_LLM__MAX_TOKENS=16000
SA_LLM__TEMPERATURE=0.2         # not accepted when provider=anthropic
SA_LLM__STREAM=true
SA_LLM__MAX_TOOL_ITERATIONS=12
SA_LLM__ENABLE_PROMPT_CACHING=true

# Anthropic-only depth controls. Ignored unless SA_LLM__PROVIDER=anthropic.
SA_LLM__THINKING=adaptive       # adaptive | disabled
SA_LLM__THINKING_DISPLAY=summarized
SA_LLM__EFFORT=high             # low | medium | high | xhigh | max

# To make Anthropic the default again: set SA_LLM__PROVIDER=anthropic,
# SA_LLM__MODEL=claude-opus-5, drop SA_LLM__TEMPERATURE, and set
# ANTHROPIC_API_KEY (or leave it unset to let the SDK resolve credentials
# itself: ANTHROPIC_AUTH_TOKEN, then an `ant auth login` profile).
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ---------------------------------------------------------------------------
# Skills
# ---------------------------------------------------------------------------
SA_SKILLS__AUTODISCOVER=true
SA_SKILLS__ENFORCE_PERMISSIONS=true
SA_SKILLS__DEFAULT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# Tools at or above this danger level require an approval decision.
SA_TOOLS__APPROVAL_REQUIRED_ABOVE=medium
SA_TOOLS__MAX_CONCURRENCY=16
SA_TOOLS__AUDIT_ARGUMENTS=true

# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------
SA_ORCHESTRATOR__MAX_PARALLEL_STEPS=8
SA_ORCHESTRATOR__DEFAULT_STEP_TIMEOUT_SECONDS=120
SA_ORCHESTRATOR__DEFAULT_RUN_TIMEOUT_SECONDS=900
SA_ORCHESTRATOR__COMPENSATE_ON_FAILURE=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
SA_API__HOST=0.0.0.0
SA_API__PORT=8000
SA_API__DOCS_ENABLED=true
SA_API__REQUIRE_AUTH=false
# SA_API__API_KEYS={"ci-runner":"replace-me"}
# SA_API__CORS_ORIGINS=["https://console.internal"]

# ---------------------------------------------------------------------------
# MCP servers — JSON array, one object per server
# ---------------------------------------------------------------------------
# Header and env values may be secret references (env:NAME, file:/path);
# they are resolved at connect time, never stored in the config object.
# SA_MCP_SERVERS=[{"name":"github","transport":"http","url":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"env:GITHUB_MCP_TOKEN"}}]
# SA_MCP_SERVERS=[{"name":"local","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
SA_TELEMETRY__ENABLED=true
# SA_TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4317
